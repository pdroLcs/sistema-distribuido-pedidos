# Configuração do container postgres
POSTGRES_DB=pedidos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Configuração do Spring para conectar ao postgres
DB_URL=jdbc:postgresql://pedido-db:5432/pedidos_db
DB_USERNAME=postgres
DB_PASSWORD=

#Configuração do RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=

# Configuração do container postgres de notificações
NOTIFICACAO_POSTGRES_DB=notificacoes_db
NOTIFICACAO_POSTGRES_USER=postgres
NOTIFICACAO_POSTGRES_PASSWORD=

# Configuração do Spring do notificacao-service para conectar ao postgres
NOTIFICACAO_DB_URL=jdbc:postgresql://notificacao-db:5432/notificacoes_db
NOTIFICACAO_DB_USERNAME=postgres
NOTIFICACAO_DB_PASSWORD=